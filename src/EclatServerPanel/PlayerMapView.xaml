<UserControl x:Class="EclatServerPanel.PlayerMapView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EclatServerPanel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="AdminStyles.xaml"/></ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="MapPlayerCard"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Room}" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Location}" Margin="0,5,0,0"/><TextBlock Style="{StaticResource Hint}"><Run Text="Carte "/><Run Text="{Binding Map, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Coordinates, Mode=OneWay}"/></TextBlock><TextBlock Style="{StaticResource Hint}"><Run Text="Badges "/><Run Text="{Binding BadgesText, Mode=OneWay}"/><Run Text=" · Pokédex "/><Run Text="{Binding DexText, Mode=OneWay}"/></TextBlock><TextBlock Style="{StaticResource Hint}"><Run Text="Connecté depuis "/><Run Text="{Binding Connected, Mode=OneWay}"/><Run Text=" · position "/><Run Text="{Binding Age, Mode=OneWay}"/></TextBlock></StackPanel></DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="260" MinHeight="220"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="120"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0"><TextBlock Text="RECHERCHER UN JOUEUR" Style="{StaticResource Overline}"/><TextBox x:Name="SearchBox" TextChanged="Filters_Changed" ToolTip="Recherche par nom, avec ou sans accents"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="SALON" Style="{StaticResource Overline}"/><ComboBox x:Name="RoomFilter" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="Filters_Changed"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="LIEU" Style="{StaticResource Overline}"/><ComboBox x:Name="PlaceFilter" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="Filters_Changed"/></StackPanel>
    </Grid>
    <local:PlayerMapCanvas x:Name="MapCanvas" Grid.Row="1"/>
    <Border x:Name="CrowdPanel" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource CardHigh}" BorderBrush="{StaticResource Cyan}" BorderThickness="1" CornerRadius="12" Padding="12" Width="340" HorizontalAlignment="Right" Margin="10">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="CrowdTitle" FontWeight="SemiBold" Margin="0,0,0,8"/><ListBox x:Name="CrowdRows" Grid.Row="1" SelectionChanged="Player_Selected"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Room}" Style="{StaticResource Hint}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
    </Border>
    <Grid Grid.Row="2" Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="MapSummary" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><RadioButton x:Name="TableMode" Content="Tableau" Style="{StaticResource Segment}" GroupName="MapMode" Tag="table" Checked="Mode_Changed"/><RadioButton x:Name="CardsMode" Content="Fiches" Style="{StaticResource Segment}" GroupName="MapMode" Tag="cards" Checked="Mode_Changed"/><RadioButton x:Name="PlacesMode" Content="Par lieu" Style="{StaticResource Segment}" GroupName="MapMode" Tag="places" Checked="Mode_Changed"/></StackPanel></Grid>
    <Grid Grid.Row="3">
      <DataGrid x:Name="PlayerTable" SelectionChanged="Player_Selected">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Joueur" SortMemberPath="Name" Width="1.4*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Salon" SortMemberPath="Room" Width="1.2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Room}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Lieu" SortMemberPath="Location" Width="1.8*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Location}"/><TextBlock Style="{StaticResource Hint}"><Run Text="{Binding Map, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Coordinates, Mode=OneWay}"/></TextBlock></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Badges" SortMemberPath="Badges" Width="0.65*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BadgesText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Pokédex" SortMemberPath="Dex" Width="0.7*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DexText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Connecté depuis" SortMemberPath="ConnectedAt" Width="0.95*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Connected}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Position" SortMemberPath="BaseAgeMs" Width="0.8*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Age}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <ListBox x:Name="PlayerCards" Visibility="Collapsed" ItemTemplate="{StaticResource MapPlayerCard}" SelectionChanged="Player_Selected"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Width" Value="310"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle></ListBox>
      <ListBox x:Name="PlayerPlaces" Visibility="Collapsed" ItemTemplate="{StaticResource MapPlayerCard}" SelectionChanged="Player_Selected"><ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" Margin="5,12,5,10"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle></ListBox>
    </Grid>
  </Grid>
</UserControl>
