<UserControl x:Class="EclatServerPanel.AdminPanelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="AdminStyles.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="BoolToVisibility"/><x:Array x:Key="EventKinds" Type="sys:String"><sys:String>Gains multipliés</sys:String><sys:String>Chromatiques (1 sur N)</sys:String></x:Array><Style x:Key="EditText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Style><Style x:Key="EditBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="TextWrapping" Value="Wrap"/></Style></ResourceDictionary></UserControl.Resources>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12"><RadioButton x:Name="CommandsTab" Style="{StaticResource Segment}" Content="Commandes" GroupName="AdminTab" Tag="commands" Checked="Tab_Changed"/><RadioButton x:Name="ConfigTab" Style="{StaticResource Segment}" Content="Évènements, bannières et prix" GroupName="AdminTab" Tag="config" Checked="Tab_Changed"/><RadioButton x:Name="StatsTab" Style="{StaticResource Segment}" Content="Statistiques" GroupName="AdminTab" Tag="stats" Checked="Tab_Changed"/></WrapPanel>
    <TextBlock x:Name="AdminState" Grid.Row="1" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
    <Grid x:Name="CommandsBody" Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,14">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid Width="34" Height="34" Margin="0,0,14,0"><Ellipse x:Name="MaintenanceHalo" Fill="{StaticResource Success}" Opacity="0.18"/><TextBlock x:Name="MaintenanceIcon" Text="&#xE8FB;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Success}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="MaintenanceState" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="En maintenance, les nouvelles connexions sont refusées et les joueurs déjà connectés peuvent finir leur partie." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="CommandChoice" Visibility="Collapsed" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="Command_Changed"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
          <ListBox x:Name="CommandTiles" SelectedValuePath="Id" SelectionChanged="CommandTile_Changed" VerticalAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Tile" Margin="0,0,10,10" Padding="16,14" CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" Cursor="Hand">
                  <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border x:Name="IconBox" Width="38" Height="38" CornerRadius="11" Background="{StaticResource CrystalSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
                      <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <DataTrigger Binding="{Binding Danger}" Value="True"><Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Danger}"/><Setter TargetName="IconBox" Property="Background" Value="#26FF5C7A"/></DataTrigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource CardHigh}"/>
                    <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Cyan}"/><Setter TargetName="Tile" Property="Background" Value="{StaticResource CrystalSoft}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Setter.Value></Setter></Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </ScrollViewer>
        <Border Grid.Column="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,16">
              <StackPanel><TextBlock Text="ACTION" Style="{StaticResource Overline}" Foreground="{StaticResource Cyan}"/><TextBlock x:Name="CommandTitle" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock x:Name="CommandDetail" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,16,20,4">
              <StackPanel x:Name="PlayerTarget" Margin="0,0,0,14"><TextBlock Text="JOUEUR CONNECTÉ" Style="{StaticResource Overline}"/><ComboBox x:Name="PlayerChoice" DisplayMemberPath="Label" SelectedValuePath="Id"/></StackPanel>
              <StackPanel x:Name="AccountTarget" Margin="0,0,0,14"><TextBlock Text="COMPTE" Style="{StaticResource Overline}"/><ComboBox x:Name="AccountChoice" DisplayMemberPath="Label" SelectedValuePath="Id"/><TextBlock Text="Seuls les huit premiers caractères de l’empreinte sont affichés. Une nouvelle clé permet de contourner un bannissement par compte." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
              <StackPanel x:Name="BanTarget" Margin="0,0,0,14"><TextBlock Text="BANNISSEMENT À LEVER" Style="{StaticResource Overline}"/><ComboBox x:Name="BanChoice" DisplayMemberPath="Label" SelectedValuePath="Id"/></StackPanel>
              <StackPanel x:Name="RoomTarget" Margin="0,0,0,14"><TextBlock Text="SALON" Style="{StaticResource Overline}"/><ComboBox x:Name="RoomChoice" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="Room_Changed"/></StackPanel>
              <StackPanel x:Name="DurationTarget" Margin="0,0,0,14"><TextBlock Text="DURÉE EN HEURES" Style="{StaticResource Overline}"/><TextBox x:Name="BanHours" Text="24"/><CheckBox x:Name="PermanentBan" Content="Sans limite de durée" Foreground="{StaticResource Text}" Margin="0,10,0,0"/></StackPanel>
              <Grid x:Name="RoomOptions" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="CAPACITÉ (2 À 10)" Style="{StaticResource Overline}"/><TextBox x:Name="RoomCapacity" Text="10"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="VISIBILITÉ" Style="{StaticResource Overline}"/><ComboBox x:Name="RoomVisibility" DisplayMemberPath="Label" SelectedValuePath="Id"/></StackPanel></Grid>
              <CheckBox x:Name="MaintenanceEnabled" Content="Refuser les nouvelles connexions" Foreground="{StaticResource Text}" Margin="0,0,0,14"/>
              <StackPanel x:Name="MoneyTarget" Margin="0,0,0,14"><TextBlock Text="MONTANT" Style="{StaticResource Overline}"/><TextBox x:Name="AmountBox" Text="100"/><TextBlock x:Name="AmountHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
              <StackPanel x:Name="ReasonTarget" Margin="0,0,0,14"><TextBlock Text="MOTIF" Style="{StaticResource Overline}"/><TextBox x:Name="ReasonBox" TextWrapping="Wrap" MaxLength="240" MinHeight="64"/></StackPanel>
            </StackPanel></ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,14">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Une confirmation est demandée avant l’envoi. L’action est inscrite au journal." Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="ExecuteButton" Grid.Column="1" Content="Exécuter…" Style="{StaticResource Primary}" Click="Execute_Click"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <ScrollViewer x:Name="ConfigBody" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,10">
      <Border Style="{StaticResource CardBox}" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="ConfigState" Style="{StaticResource CardTitle}"/><TextBlock Text="Le serveur valide la configuration, la remplace de façon atomique puis confirme son chargement. Les vingt dernières versions sont conservées." Style="{StaticResource Hint}" Margin="0,7,0,12"/><Button Content="Relire la configuration du serveur" HorizontalAlignment="Left" Click="ConfigReload_Click"/></StackPanel></Border>
      <Border Style="{StaticResource CardBox}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Prix des tirages" Style="{StaticResource CardTitle}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="UN TIRAGE" Style="{StaticResource Overline}"/><TextBox x:Name="SinglePrice"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DIX TIRAGES" Style="{StaticResource Overline}"/><TextBox x:Name="TenPrice"/></StackPanel></Grid></StackPanel></Border>
      <TextBlock Text="Évènements" Style="{StaticResource CardTitle}" Margin="0,6,0,8"/><TextBlock Text="Dates en UTC : jj/mm/aaaa hh:mm. Un taux chromatique « 1 sur N » utilise N comme valeur." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
      <DataGrid x:Name="EventsGrid" IsReadOnly="False" MinHeight="140" MaxHeight="320"><DataGrid.Columns>
        <DataGridTextColumn Header="Nom" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*" ElementStyle="{StaticResource EditText}" EditingElementStyle="{StaticResource EditBox}"/>
        <DataGridComboBoxColumn Header="Effet" SelectedItemBinding="{Binding Kind}" ItemsSource="{StaticResource EventKinds}" Width="1.8*"/>
        <DataGridTextColumn Header="Valeur" Binding="{Binding Value}" Width="70"/>
        <DataGridTextColumn Header="Début UTC" Binding="{Binding Start}" Width="155"/><DataGridTextColumn Header="Fin UTC" Binding="{Binding End}" Width="155"/>
      </DataGrid.Columns></DataGrid><WrapPanel Margin="0,8,0,18"><Button Content="Ajouter un évènement" Click="AddEvent_Click" Margin="0,0,8,0"/><Button Content="Supprimer la sélection" Click="RemoveEvent_Click"/></WrapPanel>
      <TextBlock Text="Bannières" Style="{StaticResource CardTitle}" Margin="0,6,0,8"/><TextBlock Text="Les quatre taux totalisent 10 000 (100 %). Les vedettes utilisent les identifiants fournis dans la configuration du serveur ; les réserves restent accessibles dans les réglages avancés." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
      <DataGrid x:Name="BannersGrid" IsReadOnly="False" MinHeight="170" MaxHeight="360" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="200" ElementStyle="{StaticResource EditText}" EditingElementStyle="{StaticResource EditBox}"/><DataGridCheckBoxColumn Header="Permanente" Binding="{Binding Permanent}"/>
        <DataGridTextColumn Header="Début UTC" Binding="{Binding Start}" Width="155"/><DataGridTextColumn Header="Fin UTC" Binding="{Binding End}" Width="155"/>
        <DataGridTextColumn Header="Quatre taux" Binding="{Binding Rates}" Width="180"/><DataGridTextColumn Header="Chromatique (1/N)" Binding="{Binding ShinyOneIn}" Width="120"/><DataGridTextColumn Header="Garantie" Binding="{Binding Pity}" Width="80"/><DataGridTextColumn Header="Vedettes" Binding="{Binding Featured}" Width="140"/>
      </DataGrid.Columns></DataGrid><WrapPanel Margin="0,8,0,18"><Button Content="Ajouter une bannière limitée" Click="AddBanner_Click" Margin="0,0,8,0"/><Button Content="Supprimer la sélection" Click="RemoveBanner_Click"/></WrapPanel>
      <Expander Header="Réglages avancés de la configuration" Foreground="{StaticResource Text}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Ces réglages donnent accès aux réserves des bannières et aux autres paramètres du serveur. Charger le JSON remplace les champs ci-dessus ; afficher les champs dans le JSON préserve les autres paramètres." Style="{StaticResource Hint}" Margin="0,8,0,10"/><WrapPanel><Button Content="Afficher les champs dans le JSON" Click="ExportJson_Click" Margin="0,0,8,8"/><Button Content="Charger le JSON dans les champs" Click="ImportJson_Click" Margin="0,0,0,8"/></WrapPanel><TextBox x:Name="ConfigJson" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="230"/></StackPanel></Expander>
      <TextBlock Text="MOTIF DE LA MODIFICATION OU DU RETOUR ARRIÈRE" Style="{StaticResource Overline}"/><TextBox x:Name="ConfigReason" MaxLength="240"/><Button Content="Enregistrer et contrôler le chargement…" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,10,0,18" Click="SaveConfig_Click"/>
      <Border Style="{StaticResource CardBox}"><StackPanel><TextBlock Text="Historique de configuration" Style="{StaticResource CardTitle}"/><ComboBox x:Name="ConfigVersions" DisplayMemberPath="Label" SelectedValuePath="Id" Margin="0,12,0,10"/><Button Content="Restaurer cette version…" HorizontalAlignment="Left" Click="RestoreConfig_Click"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="StatsBody" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0,0,8,10"><Button Content="Actualiser les statistiques" HorizontalAlignment="Left" Click="StatsReload_Click"/><TextBlock x:Name="StatsScope" Style="{StaticResource Hint}" Margin="0,12,0,12"/><ItemsControl x:Name="StatsTables"><ItemsControl.ItemTemplate><DataTemplate>
        <StackPanel Margin="0,0,0,16">
          <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
          <ItemsControl ItemsSource="{Binding Kpis}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Style="{StaticResource CardBox}" Margin="0,0,12,0" Padding="18,16">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource CrystalSoft}" Margin="0,0,14,0"><TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Value}" Foreground="{StaticResource Text}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Label}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/></StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Style="{StaticResource CardBox}" Padding="18,14" Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
              <Grid Margin="0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Column="1" Height="8" Margin="12,0,16,0" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding Fill}"/><ColumnDefinition Width="{Binding Rest}"/></Grid.ColumnDefinitions>
                  <Border Grid.ColumnSpan="2" CornerRadius="4" Background="{StaticResource Line}"/>
                  <Border CornerRadius="4" Background="{StaticResource Crystal}"/>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" MinWidth="250" TextAlignment="Right"/>
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </Border>
        </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
  </Grid>
</UserControl>
